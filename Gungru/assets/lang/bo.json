    "a_butter_lamp": "མཆོད་མེ་ནི་བོད་ཀྱི་ནང་པའི་སྲོལ་རྒྱུན་གྱི་མཆོད་པ་ཞིག་ཡིན། མཆོད་མེའི་འོད་སྣང་གིས་མ་རིག་པའི་མུན་པ་སེལ་ཞིང་ཤེས་རབ་ཀྱི་སྣང་བ་རྒྱས་པའི་མཚོན་དོན་ཡོད།",
    "group_monastery": "དགོན་པའི་སྐོར།",
    "q_where": "དགའ་ལྡན་ཤར་རྩེ་གུང་རུ་ཁང་ཚན་ག་པར་ཡོད་པ་རེད།",
    "a_where": "དགོན་པ་འདི་རྒྱ་གར་ལྷོ་ཕྱོགས་ ཀར་ཎ་ཊ་ཀ མངའ་སྡེའི་ མོན་གྷོ། བོད་མིའི་གཞིས་ཆགས་སུ་ཡོད།",
    "q_study": "དགེ་འདུན་པ་རྣམས་ཀྱིས་སློབ་སྦྱོང་ག་རེ་གནང་གི་ཡོད་རེད།",
    "a_study": "དགེ་འདུན་པ་རྣམས་ཀྱིས་ལོ་ངོ་ ༡༥-༢༠ རིང་གཞུང་ཆེན་བཀའ་པོད་ལྔ་ (ཚད་མ། ཕར་ཕྱིན། དབུ་མ། མཛོད་དང་འདུལ་བ་) ལ་སློབ་གཉེར་གནང་གི་ཡོད།",
    "q_visit": "ང་དགོན་པར་མཇལ་བཅར་ལ་ཡོང་ན་འགྲིག་གི་རེད་དམ།",
    "a_visit": "ལགས་འགྲིག ཁྱེད་རང་དགོན་པར་ཕེབས་པར་དགའ་བསུ་ཞུ་རྒྱུ་ཡིན། ང་ཚོར་སྔོན་ཚུད་ནས་འབྲེལ་བ་གནང་རོགས།",
    "q_support": "ངས་དགོན་པར་རོགས་པ་ག་འདྲ་བྱེད་ཐུབ་ཀྱི་རེད།",
    "a_support": "ཁྱེད་ཀྱིས་ཞལ་འདེབས་འབུལ་བ་དང་། དགེ་འདུན་པའི་ཞལ་ལག་དམ་ཤེས་ཡོན་གྱི་སྦྱིན་བདག་གནང་བ། ཞབས་རིམ་ཞུ་བ། ཡང་ན་ང་ཚོའི་ཕྱག་ལས་སྤེལ་འགྲེམས་གནང་བ་སོགས་ཀྱི་ཐོག་ནས་རྒྱབ་སྐྱོར་གནང་ཐུབ། ཞལ་འདེབས་ཆེ་ཆུང་ལ་མ་ལྟོས་པར་དགེ་འདུན་པ་རྣམས་ཀྱི་མི་ཚེར་ཕན་ཐོགས་ཆེན་པོ་ཡོད།",
    "group_mandala": "རྡུལ་ཚོན་དཀྱིལ་འཁོར་སྐོར།",
    "q_what_is_mandala": "རྡུལ་ཚོན་དཀྱིལ་འཁོར་ཟེར་བ་དེ་ག་རེ་རེད།",
    "a_what_is_mandala": "རྡུལ་ཚོན་དཀྱིལ་འཁོར་ནི་ཚོན་ལྡན་བྱེ་མ་ས་ཡ་མང་པོ་སྤྱད་ནས་བཞེངས་པའི་དཀྱིལ་འཁོར་གྱི་རི་མོ་ཞིག་ཡིན། འདི་ནི་སངས་རྒྱས་ཀྱི་ཞིང་ཁམས་མཚོན་པ་ཞིག་རེད།",
    "q_why_destroyed": "རྡུལ་ཚོན་དཀྱིལ་འཁོར་བཞེངས་ཚར་རྗེས་གཤེགས་དགོས་དོན་ག་རེ་རེད།",
    "a_why_destroyed": "འདིས་མི་རྟག་པའི་ཆོས་ཉིད་མཚོན་གྱི་ཡོད། དཀྱིལ་འཁོར་གཤེགས་པའི་བྱེ་མ་རྣམས་བྱིན་རླབས་ཀྱི་ཚུལ་དུ་འགྲེམས་སྤེལ་བྱེད་ཀྱི་ཡོད།",
    "q_where_see": "ངས་རྡུལ་ཚོན་དཀྱིལ་འཁོར་ག་པར་མཇལ་ཐུབ་ཀྱི་རེད།",
    "a_where_see": "ངེད་ཅག་གི་དགེ་འདུན་པ་རྣམས་ཀྱིས་མོན་གྷོ་དགོན་པའི་ནང་དང་ཆོ་ག་དམིགས་བསལ་ཁག་གི་སྐབས་རྡུལ་ཚོན་དཀྱིལ་འཁོར་བཞེངས་ཀྱི་ཡོད། སྤྱི་ཚོགས་དྲ་ལམ་ཐོག་རྗེས་སྐྱོང་གནང་བའམ། gadengungru@gmail.com ལ་འབྲེལ་བ་གནང་སྟེ་ལས་རིམ་གསར་ཤོས་ཀྱི་སྐོར་མཁྱེན་རྟོགས་གནང་།",
    "group_donations": "ཞལ་འདེབས་དང་སྦྱིན་བདག",
    "q_where_donation": "ངའི་ཞལ་འདེབས་ག་པར་སྤྱོད་ཀྱི་རེད།",
    "a_where_donation": "ཞལ་འདེབས་ཚང་མ་དགེ་འདུན་པའི་སྤྱི་ཚོགས་ལ་ཐད་ཀར་ཕན་ཐོགས་ཡོད། མ་དངུལ་རྣམས་དགེ་འདུན་པ་ ༣༠ ལྷག་གི་ <strong>ཉིན་རེའི་ཞལ་ལག</strong> དང་། <strong>སློབ་གཉེར་གྱི་ཅ་ཆས</strong> (སློབ་དེབ། རྩོད་གླེང་གི་དཔེ་ཆ། དཔེ་མཛོད་ཀྱི་མཐུན་རྐྱེན།)། <strong>འཕྲོད་བསྟེན</strong> (ཁྱད་པར་བགྲེས་སོང་དགེ་འདུན་པའི་ཆེད་)། འདུ་ཁང་དང་གྲྭ་ཤག ཐབ་ཚང་བཅས་ <strong>ཁང་པ་ཉམས་གསོ</strong>། ཞབས་རིམ་དང་མཆོད་པའི་ <strong>ཆོ་ག་ཅ་ཆས</strong> བཅས་ལ་བཀོལ་སྤྱོད་བྱེད་ཀྱི་ཡོད། ངེད་ཅག་ནི་སྤྱི་ཚོགས་ཆུང་ཆུང་ཞིག་ཡིན་ཞིང་། ཞལ་འདེབས་རེ་རེས་ཕན་ཐོགས་མངོན་གསལ་ཡོད།",
    "q_sponsor_monk": "ངས་དགེ་འདུན་པ་གཅིག་གི་སྦྱིན་བདག་བྱེད་ཐུབ་ཀྱི་རེད་དམ།",
    "a_sponsor_monk": "ལགས་ཐུབ། ངེད་ཅག་གི་དགེ་འདུན་པའི་སྦྱིན་བདག་ལས་གཞིས་ཁྱེད་ཀྱིས་དགེ་འདུན་པ་གཅིག་གི་ཞལ་ལག་དང་། ཤེས་ཡོན། འཚོ་བའི་མཐུན་རྐྱེན་བཅས་ལ་ཟླ་རེ་རོགས་རམ་གནང་ཐུབ། དགེ་འདུན་པ་གཅིག་གི་སྦྱིན་བདག་ལ་ <strong>ཟླ་རེར་ ₹༣,༠༠༠ / $༣༥ ཨ་སྒོར་</strong> ཙམ་འགོར་ཞིང་། འདིས་ཞལ་ལག་དང་སློབ་དེབ། འཕྲོད་བསྟེན་བཅས་ཁྱབ་ཀྱི་ཡོད། <a href=\"mailto:gadengungru@gmail.com\" style=\"color:var(--maroon);font-weight:600;\">gadengungru@gmail.com</a> ལ་འབྲེལ་བ་གནང་ན། ངེད་ཅག་གིས་ཁྱེད་ལ་དགེ་འདུན་པ་གཅིག་དང་མཐུན་འབྲེལ་བྱས་ཏེ་ཁོང་གི་ཡར་རྒྱས་གནས་ཚུལ་མཁོ་སྤྲོད་བྱེད་རྒྱུ་ཡིན།",
    "q_tax_deductible": "ངའི་ཞལ་འདེབས་ལ་ཁྲལ་བཅག་ཐུབ་ཀྱི་རེད་དམ།",
    "a_tax_deductible": "<strong>རྒྱ་གར་གྱི་སྦྱིན་བདག</strong> རྣམས་ཀྱི་ཞལ་འདེབས་ལ་ཁྲལ་བཅག་ཆ་རྐྱེན་ཚང་གི་ཡོད། (ཁྲོམ་ར་ཁྲལ་ཁྲིམས་ Article 80G ལྟར།) ཞུ་མཁན་ཡོད་ན་ 80G ཡིག་ཆ་མཁོ་སྤྲོད་བྱེད་ཐུབ། <strong>རྒྱལ་སྤྱིའི་སྦྱིན་བདག</strong> རྣམས་ཀྱི་ཁྲལ་བཅག་ཆ་རྐྱེན་ནི་རྒྱལ་ཁབ་སོ་སོའི་ཁྲིམས་ལུགས་ལ་རག་ལས་ཡོད། ཞལ་འདེབས་ཚང་མར་བྱུང་འཛིན་མཁོ་སྤྲོད་བྱེད་ཀྱི་ཡོད། ཁྱེད་རང་གི་ས་གནས་ཀྱི་ཁྲལ་སྐོར་ལྟ་རྟོག་པར་ཞུ་རོགས།",
    "q_currencies": "ཁྱེད་ཅག་གིས་དངུལ་ལོར་ག་རེ་ག་རེ་ལེན་གྱི་ཡོད།",
    "a_currencies": "ངེད་ཅག་གིས་ <strong>INR, USD, EUR, GBP, AUD, CAD, SGD, HKD</strong> སོགས་དངུལ་ལོར་མང་པོ་ཉེན་སྲུང་ལྡན་པའི་དྲ་ཐོག་སྤྲོད་ལམ་བརྒྱུད་ལེན་གྱི་ཡོད། དེ་བཞིན་དངུལ་ཁང་བརྒྱུད་སྤྲོད་ (རྒྱ་གར་གྱི་སྦྱིན་བདག་ཆེད་ NEFT/IMPS) དང་ UPI བརྒྱུད་ཀྱང་འབུལ་ཐུབ། སྤྲོད་ལམ་ཚང་མའི་སྐོར་ངེད་ཅག་གི་ <a href=\"donate.html\" style=\"color:var(--maroon);font-weight:600;\">ཞལ་འདེབས་ངོས</a> ལ་གཟིགས་རོགས།",
    "q_recurring": "ཟླ་རེའི་རྒྱུན་མཐུད་ཞལ་འདེབས་བཀོད་ཐུབ་ཀྱི་རེད་དམ།",
    "a_recurring": "ལགས་ཐུབ། ངེད་ཅག་གི་ <a href=\"donate.html\" style=\"color:var(--maroon);font-weight:600;\">ཞལ་འདེབས་ངོས</a> ཐོག་ཟླ་རེའི་རྒྱུན་མཐུད་ཀྱི་འདེམས་གཞི་ཡོད། ཞལ་འདེབས་གནང་སྐབས་ \"ཟླ་རེ\" འདེམས་ན་འགྲིག ནམ་ཡང་མཚམས་བཞག་ཆོག རྒྱུན་མཐུད་ཞལ་འདེབས་ལ་ཁྱད་པར་ཆེ་བའི་གལ་ཆེན་ཡོད། གང་ཡིན་ཟེར་ན་དེས་ངེད་ཅག་ལ་དགེ་འདུན་པའི་ཉིན་རེའི་མཁོ་ཆས་ལ་སྔོན་འགྲོའི་འཆར་གཞི་བཀོད་པར་ཕན་ཐོགས་ཡོད།",
    "q_donation_confirm": "ངའི་ཞལ་འདེབས་ཕུལ་ཟིན་པ་ཇི་ལྟར་ཤེས་ཐུབ།",
    "a_donation_confirm": "ཁྱེད་ཀྱི་ཞལ་འདེབས་བཀོད་ཚར་བ་དང་། <strong>གཏན་འབེབས་གློག་འཕྲིན</strong> དང་བྱུང་འཛིན་ཐད་ཀར་ཕྱིར་འབྱོར་རྒྱུ་ཡིན། མཐུན་མོང་བྱས་ཡོད་ན། ཁྱེད་ཀྱི་ཞལ་འདེབས་ཀྱིས་དགོན་པར་ཇི་ལྟར་ཕན་ཐོགས་བྱུང་བའི་གསར་འགྱུར་ཡང་དུས་མཐུན་མཁོ་སྤྲོད་བྱེད་ཀྱི་ཡོད། ཆུ་ཚོད་ ༢༤ ནང་གཏན་འབེབས་མ་བྱུང་ན། ཕྱིར་འཐེན་གློག་འཕྲིན་སྒམ་ནང་ལྟོས་དང་། ཡང་ན་ <a href=\"mailto:gadengungru@gmail.com\" style=\"color:var(--maroon);font-weight:600;\">gadengungru@gmail.com</a> ལ་འབྲེལ་བ་གནང་རོགས།",
    "group_visiting": "དགོན་པར་མཇལ་བཅར།",
    "q_best_time": "མཇལ་བཅར་ལ་ཕེབས་དུས་གང་ཡག་ཤོས་རེད།",
    "a_best_time": "མཇལ་བཅར་གྱི་དུས་ཡག་ཤོས་ནི་ <strong>སྤྱི་ཟླ་བཅུ་པ་ནས་གསུམ་པ་</strong> བར་ཡིན། དུས་དེར་རྒྱ་གར་ལྷོ་ཕྱོགས་ཀྱི་གནམ་གཤིས་བསིལ་ཞིང་བདེ་པོ་ཡོད། དབྱར་ཆུ་དུས་ (སྤྱི་ཟླ་དྲུག་ནས་དགུ་བར་) ཆར་པ་ཆེན་པོ་འབབ་ཀྱི་ཡོད་པས་འགྲུལ་བཞུད་ཁག་པོ་ཡོད། གལ་སྲིད་ནང་པའི་དུས་ཆེན་ — <strong>ལོ་གསར</strong> (བོད་ལོ་གསར་པ། སྤྱི་ཟླ་གཉིས/གསུམ།)། <strong>ས་ག་ཟླ་བ</strong> (སྤྱི་ཟླ་ལྔ/དྲུག)། ཡང་ན་ལོ་ལྟར་གྱི་ <strong>སྨོན་ལམ་ཆེན་མོ</strong> — བཅས་ཀྱི་སྐབས་ཕེབས་ན། ཆོ་ག་དམིགས་བསལ་དང་དགའ་སྟོན་མཇལ་ཐུབ།",
    "q_how_get_there": "མོན་གྷོ་ལ་ཇི་ལྟར་ཕེབས་དགོས།",
    "a_how_get_there": "མོན་གྷོ་ནི་རྒྱ་གར་ ཀར་ཎ་ཊ་ཀ མངའ་སྡེའི་ ཨུ་ཊ་ར་ཀ་ན་ར་ རྫོང་ནང་ཡོད། ཉེ་ཤོས་ཀྱི་གནམ་ཐང་ནི་ <strong>ཧུབ་ལི (HBX)</strong> ཡིན་ཞིང་། ལམ་ཐོག་ཆུ་ཚོད་ ༡.༥ ཙམ་འགོར། གཞན་ཡང་ <strong>གོ་ཝ (GOI)</strong> གནམ་ཐང་ (~ཆུ་ཚོད་ ༤) དང་ <strong>བེང་ག་ལུ་རུ (BLR)</strong> (~ཆུ་ཚོད་ ༨) ནས་ཕེབས་ཐུབ། ཧུབ་ལི་ནས་ཏག་སི་གླས་པའམ་ས་གནས་ཀྱི་འཁོར་ལམ་ནས་མོན་གྷོ་ལ་ཕེབས་ཐུབ། སྔོན་ཚུད་ནས་འབྲེལ་བ་གནང་ན་འགྲུལ་བཞུད་ཀྱི་མཐུན་རྐྱེན་འགྲིག་ཐུབ།",
    "q_accommodation": "དགོན་པའི་ཉེ་འགྲམ་ལ་སྡོད་ཁང་ཡོད་རེད་དམ།",
    "a_accommodation": "ལགས་ཡོད། མོན་གྷོ་བོད་མིའི་གཞིས་ཆགས་ནང་ <strong>མགྲོན་ཁང་</strong> ཁ་ཤས་ཡོད་ཞིང་། སྡོད་ཁང་གཞི་རྩའི་ཆ་ནས་འོས་འཚམས་ཡོད། དེ་བཞིན་མོན་གྷོ་ཉེ་འགྲམ་གྱི་གྲོང་ཁྱེར་ ཧུབ་ལི་ སོགས་སུ་མགྲོན་ཁང་གི་འདེམས་གཞི་མང་བ་ཡོད། <a href=\"mailto:gadengungru@gmail.com\" style=\"color:var(--maroon);font-weight:600;\">gadengungru@gmail.com</a> ལ་འབྲེལ་བ་གནང་ན། ངེད་ཅག་གིས་སྡོད་ཁང་གི་འོས་སྦྱོར་དང་ཁྱེད་ཀྱི་བཞུགས་སྒར་འགྲིག་ཐབས་བྱེད་ཐུབ།",
    "q_dress_code": "ག་རེ་གྱོན་དགོས། ཀུན་སྤྱོད་ཇི་ལྟར་བྱེད་དགོས།",
    "a_dress_code": "དཔུང་པ་དང་པུས་མོ་ཁེབས་པའི་ <strong>བྱ་སྤྱོད་ཡག་པོའི་གོས</strong> གྱོན་རོགས། འདུ་ཁང་ནང་འཛུལ་སྐབས <strong>ལྷམ་ཕུད་</strong> ཅིང་ཁ་པར་ལྷོད་ལྷོད་ལ་བཞག་རོགས། སྤྱིར་བཏང་ས་ཁུལ་དུ་པར་ལེན་བྱས་ཆོག་མོད། དགེ་འདུན་པ་དང་ཆོ་ག་ཕྱག་ལེན་གྱི་པར་ལེན་གནང་སྔོན་ <strong>ཆོག་མཆན་ཞུ་རོགས</strong>། མཇལ་བཅར་བས་ཞལ་འདོན་དུས་སུ་ <strong>གུས་ཞབས་དང་སྒྲ་མེད</strong> པའི་སྤྱོད་པ་གནང་དགོས། དགེ་འདུན་པ་རྣམས་བཟང་སྤྱོད་ཅན་ཡིན་ཞིང་། ཞལ་འདོན་དུས་མིན་པར་དྲི་བ་ཁག་ལ་ལན་འདེབས་གནང་རྒྱུར་དགའ་པོ་ཡོད།",
    "q_attend_prayers": "ངས་ཞལ་འདོན་ཆོ་ག་ལ་མཉམ་ཞུགས་བྱེད་ཆོག་གམ།",
    "a_attend_prayers": "ལགས་ཆོག མཇལ་བཅར་བ་རྣམས་འདུ་ཁང་ནང་ཉིན་རེའི་ <strong>སྔ་དྲོ་དང་དགོང་མོའི་ཞལ་འདོན</strong> ལ་མཉམ་ཞུགས་གནང་ཆོག ཁྱེད་རང་རྒྱབ་ཕྱོགས་སུ་སྒྲ་མེད་པར་བཞུགས་ནས་ལྟ་ཆོག ཞལ་འདོན་དང་ཕྱག་འཚལ་ལ་མཉམ་ཞུགས་མི་དགོས — གུས་ཞབས་ཀྱི་བསམ་པ་བཟུང་ནས་བཞུགས་པས་ཆོག དམིགས་བསལ་གྱི་ཞབས་རིམ་དང་ཆོ་ག་ཁག་ལའང་མཇལ་བཅར་བ་ཕེབས་ཆོག དགེ་འདུན་པ་ཞིག་ལ་ཞུ་བའམ་ང་ཚོར་འབྲེལ་བ་གནང་སྟེ་དུས་ཚོད་ཀྱི་ལས་རིམ་ཞུ་ཆོག",
    "q_arrange_visit": "མཇལ་བཅར་སྔོན་ཚུད་ནས་འཆར་གཞི་བཀོད་དགོས་རེད་དམ།",
    "a_arrange_visit": "ངེད་ཅག་གིས་ <strong>སྔོན་ཚུད་ནས་འབྲེལ་བ་གནང་བ་</strong> གཙང་མ་ཞུ་རྒྱུ་ཡིན། <a href=\"mailto:gadengungru@gmail.com\" style=\"color:var(--maroon);font-weight:600;\">gadengungru@gmail.com</a> ལ་གློག་འཕྲིན་གནང་རོགས། འདིས་ངེད་ཅག་ལ་ཁྱེད་ལ་དགའ་བསུ་ཞུ་བའི་དགེ་འདུན་པ་འགྲིག་ཐབས་དང་། དགོན་པའི་ལམ་ཁྲིད་འགྲིག་ཐབས། སྡོད་ཁང་གི་འོས་སྦྱོར་བཅས་བྱེད་ཐུབ། བདམས་མེད་པར་ཕེབས་ཀྱང་དགའ་བསུ་ཡོད་མོད། སྔོན་ཚུད་ནས་འབྲེལ་བ་གནང་ན་མྱོང་བ་ཕུན་སུམ་ཚོགས་པ་ཞིག་མཁོ་སྤྲོད་བྱེད་ཐུབ།",
    "group_puja_details": "ཞབས་རིམ་ཞུ་བ — ཉམས་ལེན་གྱི་ཞིབ་ཕྲ།",
    "q_puja_timeline": "ཞབས་རིམ་ཞུས་ནས་གསུང་བར་དུས་ཚོད་ག་ཚོད་འགོར་གྱི་རེད།",
    "a_puja_timeline": "ཞབས་རིམ་ཕལ་ཆེ་བ་ཞུ་བ་བཞེས་ནས་ <strong>བདུན་ ༡-༢</strong> ནང་གསུང་གི་ཡོད། དུས་ཚོད་ནི་དགོན་པའི་ཞལ་འདོན་ལས་རིམ་དང་ཞབས་རིམ་གྱི་རིགས་ལ་རག་ལས། ནད་པ་ཚབས་ཆེན་དང་ཉེ་འབྲེལ་འདས་པ་ལྟ་བུའི་ <strong>བྱེད་དགོས་ཆེན་པོའི</strong> གནས་ཚུལ་ཡིན་ན། ཉིན་ཁ་ཤས་ནང་ཞབས་རིམ་འགྲིག་ཐུབ། ཁྱེད་ཀྱི་ཐུགས་ལ་ཚེས་གྲངས་དམིགས་བསལ་ཞིག་ཡོད་ན། ཞུ་བའི་ནང་བཀོད་ན། ངེད་ཅག་གིས་འཚམ་ཐབས་མཐར་ཐུག་བྱེད་རྒྱུ་ཡིན།",
    "q_puja_cost": "ཞབས་རིམ་ལ་རིན་གོང་ག་ཚོད་འགོར་གྱི་རེད།",
    "a_puja_cost": "ཞབས་རིམ་ལ་ <strong>རིན་གོང་གཏན་འབེབས་མེད</strong>། ཞབས་རིམ་ཆོ་ག་ནི་ཞལ་འདེབས་འབུལ་མི་ཐུབ་པ་ལ་མ་ལྟོས་པར་ཞུ་མཁན་སུ་ཡིན་ཡང་འབུལ་གྱི་ཡོད། འོན་ཀྱང་། བསམ་ཚུལ་གྱི་མཆོད་འབུལ་ནི་ཆོ་ག་གི་རིགས་དང་ཡུན་ཚད་ལ་ལྟོས་ནས་ <strong>₹༥༠༠–₹༥,༠༠༠</strong> (ཨ་སྒོར་ $༦–$༦༠ ཙམ་) ཡིན། ཞལ་འདེབས་ཀྱིས་མཆོད་པའི་ཅ་ཆས་དང་མཆོད་མེ། ཞབས་རིམ་ཅ་ཆས་བཅས་ཀྱི་རྗེས་གཏོགས་དང་དགེ་འདུན་པའི་འཚོ་བར་རོགས་རམ་བྱེད།",
    "q_puja_deceased": "ཚེ་འདས་ཡིན་པ་ཞིག་གི་ཆེད་དུ་ཞབས་རིམ་ཞུ་ཐུབ་ཀྱི་རེད་དམ།",
    "a_puja_deceased": "ལགས་ཐུབ། གཤིན་པོའི་ཆེད་དུ་སྨོན་ལམ་ཞུ་བ་ནི་ངེད་ཅག་གི་ཞབས་རིམ་ཞུ་བའི་ནང་གལ་ཆེ་ཤོས་དང་མང་ཤོས་ཤིག་ཡིན། བོད་ཀྱི་ནང་ཆོས་ནང་། གྲོངས་ནས་ <strong>ཉིན་ ༤༩</strong> ནང་གི་སྨོན་ལམ་དང་བསོད་ནམས་ནི་རྣམ་ཤེས་ལ་སྐྱེ་བ་བཟང་པོ་ཐོབ་པར་ཁྱད་པར་ཆེ་བའི་ནུས་པ་ཡོད་པར་བརྩི་གི་ཡོད། ངེད་ཅག་གིས་གཤིན་པོའི་ཆེད་དུ་དམིགས་བསལ་གྱི་ཞལ་འདོན་དང་། མཆོད་མེ་འབུལ་བཤམས། བསོད་ནམས་བསྔོ་བའི་ཆོ་ག་བཅས་གསུང་གྱི་ཡོད། ཉིན་ ༤༩ འདས་རྗེས་ཀྱང་ནམ་ཡང་ཞུ་ཆོག",
    "q_puja_confirmation": "ཞབས་རིམ་གསུང་ཚར་རྗེས་གཏན་འབེབས་ཐོན་གྱི་རེད་དམ།",
    "a_puja_confirmation": "ལགས་ཐོན། ཞབས་རིམ་གསུང་ཚར་རྗེས། ཆོ་ག་གསུང་བའི་ཚེས་གྲངས་དང་ཞིབ་ཕྲ་ཁག་དང་བཅས་པའི་ <strong>གཏན་འབེབས་གློག་འཕྲིན</strong> ཞིག་འབྱོར་རྒྱུ་ཡིན། ཐུབ་ཚད་ཀྱི་སྐབས། མཆོད་པ་དང་འདུ་ཁང་གི་པར་ཡང་ཚུད་ཀྱི་ཡོད། གློག་འཕྲིན་ནང་དགེ་འདུན་པ་རྣམས་ཀྱི་ <strong>བྱིན་རླབས་ཀྱི་འཕྲིན་ཡིག</strong> ཡོད་ཅིང་། ཁྱེད་ཀྱིས་ཞབས་རིམ་བསྔོ་ས་དེར་མཉམ་སྤྱོད་གནང་ཆོག",
    "q_puja_remote": "རྒྱ་གར་ཕྱི་ནས་ཞབས་རིམ་ཞུ་ཐུབ་ཀྱི་རེད་དམ།",
    "a_puja_remote": "ཧ་ཅང་ཐུབ། ངེད་ཅག་གི་ཞབས་རིམ་ཞུ་བའི་ཕལ་ཆེ་བ་འཛམ་གླིང་ས་ཕྱོགས་འདྲ་མིན་ནས་ཡོང་གི་ཡོད། ངེད་ཅག་གི་དགེ་འདུན་པ་རྣམས་ཀྱིས་ཆོ་ག་ཚང་མ་རྒྱ་གར་མོན་གྷོ་དགོན་པའི་ནང་གསུང་གི་ཡོད་ཅིང་། <strong>བྱིན་རླབས་ལ་ས་མཚམས་ཀྱི་ཚད་བཀག་མེད</strong>། ངེད་ཅག་གི་ <a href=\"request-puja.html\" style=\"color:var(--maroon);font-weight:600;\">ཞབས་རིམ་ཞུ་ངོས</a> བརྒྱུད་ཡང་ན་ <a href=\"mailto:gadengungru@gmail.com\" style=\"color:var(--maroon);font-weight:600;\">gadengungru@gmail.com</a> ལ་གློག་འཕྲིན་བརྒྱུད་ཞུ་ཆོག",
    "q_puja_info_needed": "ཞབས་རིམ་ཞུ་བར་གནས་ཚུལ་ག་རེ་དགོས་ཀྱི་རེད།",
