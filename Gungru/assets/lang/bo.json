    "q_what_is_buddhism": "བོད་ཀྱི་ནང་ཆོས་ཟེར་བ་དེ་ག་རེ་རེད།",
    "a_what_is_buddhism": "བོད་ཀྱི་ནང་ཆོས་ནི་ཐེག་པ་ཆེན་པོའི་ཆོས་ཀྱི་ནང་ཚན་ཞིག་སྟེ། བོད་དང་ཧི་མ་ལ་ཡའི་རི་རྒྱུད་དུ་དར་ཁྱབ་བྱུང་བ་ཞིག་ཡིན། འདིའི་ནང་སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱི་གསུང་དང་། གསང་སྔགས་ཀྱི་ཉམས་ལེན། ལྟ་གྲུབ་སློབ་གཉེར། ཆོ་ག་ཕྱག་ལེན་བཅས་ཚུད་ཡོད། འདིས་སེམས་ཅན་ཐམས་ཅད་ལ་སྙིང་རྗེ་དང་། ཤེས་རབ་འཚོལ་བ། གཞན་དོན་དུ་སངས་རྒྱས་ཀྱི་གོ་འཕང་ཐོབ་པར་འབད་པ་བྱེད་ཀྱི་ཡོད།",
    "q_gelug": "དགེ་ལུགས་པའི་སྲོལ་རྒྱུན་ཟེར་བ་དེ་ག་རེ་རེད།",
    "a_gelug": "དགེ་ལུགས་པའི་ཆོས་བརྒྱུད་ནི་ཕྱི་ལོ་དུས་རབས་ ༡༥ པའི་ནང་རྗེ་ཙོང་ཁ་པ་ཆེན་པོས་ཕྱག་བཏབ། བོད་ཀྱི་ཆོས་བརྒྱུད་ཆེན་པོ་བཞིའི་ཡ་གྱལ་ཞིག་ཡིན། འདིས་ལྟ་གྲུབ་སློབ་གཉེར་ནན་པོ་དང་། འདུལ་བའི་སྒྲིག་ལམ། བྱང་ཆུབ་ལམ་རིམ་བཅས་ལ་གཙོ་བོར་འཛིན་གྱི་ཡོད། དགའ་ལྡན་དགོན་པ་ནི་ཕྱི་ལོ་ ༡༤༠༩ ལོར་རྗེ་རིན་པོ་ཆེ་ཉིད་ཀྱིས་ཕྱག་བཏབ་པའི་དགེ་ལུགས་པའི་མ་དགོན་ཡིན། ༸གོང་ས་༸སྐྱབས་མགོན་ཆེན་པོ་མཆོག་ནི་དགེ་ལུགས་པའི་བླ་ན་མེད་པའི་དབུ་ཁྲིད་ཡིན།",
    "q_khangtsen": "ཁང་ཚན་ཟེར་བ་དེ་ག་རེ་རེད།",
    "a_khangtsen": "ཁང་ཚན་ནི་བོད་ཀྱི་དགོན་པ་ཆེན་པོ་རྣམས་ཀྱི་ནང་གསེས་ས་གནས་ཀྱི་སྡེ་ཚན་ཞིག་ཡིན། དགེ་འདུན་པ་རྣམས་བོད་ཀྱི་ཕ་ཡུལ་ས་གནས་གཞིར་བཟུང་ཁང་ཚན་སོ་སོར་སྒྲིག་ཞུགས་བྱེད་ཀྱི་ཡོད། གུང་རུ་ཁང་ཚན་ནི་དགའ་ལྡན་ཤར་རྩེ་གྲྭ་ཚང་གི་ཁང་ཚན་བཅུ་གཅིག་གི་ཡ་གྱལ་ཞིག་ཡིན། ཁང་ཚན་རེས་རང་གི་དགེ་འདུན་པ་རྣམས་ལ་སྡོད་ཁང་དང་། ཞལ་ལག མཐུན་རྐྱེན་སྦྱོར་གྱི་ཡོད།",
    "q_four_truths": "འཕགས་པའི་བདེན་པ་བཞི་ག་རེ་རེད།",
    "a_four_truths": "འཕགས་པའི་བདེན་པ་བཞི་ནི་ནང་པའི་ཆོས་ཀྱི་རྩ་བའི་སློབ་གསོ་སྟེ། སྟོན་པ་བཅོམ་ལྡན་འདས་ཀྱིས་མངོན་པར་རྫོགས་པར་སངས་རྒྱས་རྗེས་ཐོག་མར་གསུངས་པའི་ཆོས་ཡིན། དེ་དག་ནི་ (༡) སྡུག་བསྔལ་བདེན་པ། (༢) ཀུན་འབྱུང་བདེན་པ། (༣) འགོག་པའི་བདེན་པ། (༤) ལམ་གྱི་བདེན་པ་བཅས་ཡིན།",
    "group_pujas": "ཞབས་རིམ་དང་སྐུ་རིམ་སྐོར།",
    "q_what_is_puja": "Puja (ཆོ་ག་) ཟེར་བ་དེ་ག་རེ་རེད།",
    "a_what_is_puja": "Puja ནི་དགེ་འདུན་པ་རྣམས་ཀྱིས་གསུང་བའི་ནང་པའི་སྐུ་རིམ་ཞིག་ཡིན། འདིའི་ནང་གསུང་རབ་ཞལ་འདོན་དང་། མཆོད་པ་འབུལ་བ། ནད་གཅོང་དང་བར་ཆད་སེལ་བའི་ཆོ་ག་སོགས་ཚུད་ཡོད།",
    "q_puja_types": "ངས་ཞབས་རིམ་ག་རེ་ག་རེ་ཞུ་ཐུབ་ཀྱི་རེད།",
    "a_puja_types": "ངེད་ཅག་གིས་སྨན་བླའི་ཆོ་ག་ (ནད་གཅོང་སེལ་བར་) དང་། སྒྲོལ་མའི་ཆོ་ག་ (བར་ཆད་སེལ་བར་)། འཇམ་དཔལ་མཚན་བརྗོད་ (ཤེས་རབ་ཆེད་)། བླ་མ་མཆོད་པ་ (བྱིན་རླབས་ཆེད་) བཅས་གསུང་གི་ཡོད། དེ་བཞིན་གཤིན་པོའི་ཆེད་དུའང་བསྔོ་སྨོན་གསུང་བཞིན་ཡོད།",
